// Nyx — OpenClaw configuration
// Copy to secrets/openclaw.json5 and fill in your values.
// The secrets/ directory is gitignored — your credentials stay local.

{
  agents: {
    defaults: {
      workspace: '/data/workspace',  // persist agent memory across container rebuilds
      sandbox: { mode: 'off' },
      model: {
        // primary: 'llamacpp/your-model.gguf',
      },
      // contextTokens: 131072,  // align with the reduced Nyx llama.cpp launcher budget
      // timeoutSeconds: 1800,   // fail stuck long-running requests sooner
      // compaction: {
      //   mode: 'safeguard',
      //   reserveTokens: 26214,  // ~20% reserve on a 131072-token budget; compaction starts around 80% usage
      //   truncateAfterCompaction: true,
      //   maxActiveTranscriptBytes: 3000000,
      //   maxHistoryShare: 0.6,
      //   midTurnPrecheck: { enabled: true },
      //   memoryFlush: { enabled: true },
      // },
      // Route image requests to a vision-capable model.
      // Enable if your llama.cpp server is loaded with --mmproj (vision projector).
      // imageModel: {
      //   primary: 'llamacpp/your-model.gguf',
      // },
    },
  },

  models: {
    mode: 'merge',
    providers: {
      // Local llama.cpp inference
      llamacpp: {
        // baseUrl: 'http://192.168.1.x:8008/v1',
        // api: 'openai-completions',
        // apiKey: 'local_inference',
        // Required when baseUrl points at a trusted RFC1918/LAN host and
        // OpenClaw's guarded transport is used for streaming usage metadata.
        // request: { allowPrivateNetwork: true },
        // models: [
        //   { id: 'your-model.gguf', name: 'Local Model', contextWindow: 131072, maxTokens: 12288 },
        // ],
      },
      // Or use cloud providers
      // anthropic: { apiKey: 'sk-ant-...' },
      // openai: { apiKey: 'sk-...' },
    },
  },

  tools: {
    // Useful for weaker local models that can otherwise repeat the same
    // malformed MCP/tool call in a loop after a validation failure.
    loopDetection: {
      enabled: true,
      historySize: 30,
      warningThreshold: 4,
      criticalThreshold: 6,
      globalCircuitBreakerThreshold: 8,
      detectors: {
        genericRepeat: true,
        knownPollNoProgress: true,
        pingPong: true,
      },
    },
  },

  // MCP servers — expose external tools to the agent via Model Context Protocol.
  // Docs: https://docs.openclaw.ai/cli/mcp
  // mcp: {
  //   servers: {
  //     sonar: {
  //       command: '/usr/local/bin/sonar-mcp',
  //       env: {
  //         SONAR_MCP_TRANSPORT: 'stdio',
  //       },
  //     },
  //     synapse: {
  //       command: '/usr/local/bin/synapse-mcp',
  //       env: { SYNAPSE_MCP_TRANSPORT: 'stdio' },
  //     },
  //     scrapling: {
  //       command: '/usr/local/bin/scrapling',
  //       args: ['mcp'],
  //     },
  //     'my-server': {
  //       command: '/path/to/executable',
  //       args: ['-m', 'module.name'],
  //       env: { CONFIG: '/path/to/config' },
  //       cwd: '/working/directory',
  //     },
  //   },
  // },

  gateway: {
    // bind: 'lan',  // expose WebUI outside container — requires auth.password
    // controlUi: { enabled: true },
    // auth: { mode: 'password', password: 'change_me' },
  },

  channels: {
    telegram: {
      // enabled: true,
      // botToken: 'get from @BotFather',
      // dmPolicy: 'pairing',
    },
    whatsapp: {
      // dmPolicy: 'pairing',
    },
    web: {
      // enabled: true,  // required for WhatsApp
    },
  },
}
