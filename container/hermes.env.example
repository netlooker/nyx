# Nyx — Hermes Agent environment overrides
# Copy to secrets/hermes.env and fill in your values.
# The secrets/ directory is gitignored — your credentials stay local.

# Required for custom OpenAI-compatible inference providers unless api_key is
# embedded directly in secrets/hermes.yaml.
OPENAI_API_KEY=local_inference

# Optional explicit provider endpoint override. The matching value can also
# live in secrets/hermes.yaml under model.base_url.
# OPENAI_BASE_URL=http://192.168.1.x:8008/v1

# Optional messaging/platform credentials.
# TELEGRAM_BOT_TOKEN=
# DISCORD_TOKEN=
# SLACK_BOT_TOKEN=
# SIGNAL_ACCOUNT=
# SIGNAL_HTTP_URL=
